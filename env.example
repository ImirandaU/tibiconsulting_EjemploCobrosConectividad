# Copiar este archivo a ".env" y completar con los valores reales.
# El archivo ".env" NUNCA debe subirse al repositorio (agregarlo a .gitignore).

DB_HOST=localhost
DB_PORT=5432
DB_NAME=nombre_de_tu_bd
DB_USER=usuario
DB_PASSWORD=clave

# Carpetas donde el pipeline busca los archivos de entrada y deja los reportes.
INPUT_DIR=./data/input
OUTPUT_DIR=./data/output

# Nombres de los esquemas de base de datos (opcional, tienen defaults).
RAW_SCHEMA=raw
DB_SCHEMA=billing
